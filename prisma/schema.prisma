generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINEE
  MANAGER
  ADMIN
}

model RolePermission {
  id          String   @id @default(cuid())
  roleName    String   @unique
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  permissions Json     @default("[]") // String array of granted keys, e.g. ["dashboard:view", "users:create"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  cardNumber   String?       @unique // Card / Employee Punch ID Number
  fullName     String
  email        String        @unique
  phone        String?
  department   String?
  designation  String?
  image        String?
  passwordHash String
  employees    Employee[]
  role         String        @default("TRAINEE")
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Employee {
  id            String   @id @default(cuid())
  employeeCode  String   @unique // e.g. EMP-1001, Punch ID
  name          String
  designation   String
  contactNumber String
  personalEmail String?
  officeEmail   String?
  joiningDate   DateTime
  status        String   @default("Active") // Active, Inactive

  // Hierarchy relations
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId    String?
  section      Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Optional link to system login account if they are also an app user
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Devices status

model DeviceStatus {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#0010F5")
  visibility  String   @default("Active") // Active, Inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id                String  @id @default("default-org")
  // General Information
  businessName      String?
  shortName         String?
  emailAddress      String?
  phoneNumber       String?
  physicalAddress   String?
  workingHours      String?
  footerDescription String?
  systemTimezone    String?

  // SEO & Metadata
  globalMetaTitle String?
  metaKeywords    String?
  metaDescription String?
  robotsTxt       String?

  // Social Links
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?

  // Branding & Media
  mainLogo          String?
  favicon           String?
  ogImage           String?
  officialSignature String?
  primaryColor      String?
  secondaryColor    String?
  accentColor       String?

  // Analytics
  ga4Id     String?
  fbPixelId String?

  updatedAt DateTime @updatedAt
}

// Master Data model
model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  shortName   String?
  address     String?
  logo        String?
  departments Department[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String     @id @default(cuid())
  name        String
  description String?
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections    Section[]
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, companyId])
}

// hardware specs

model Brand {
  id           String        @id @default(cuid())
  name         String
  category     String
  remarks      String?
  models       DeviceModel[]
  motherboards Motherboard[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, category])
}

model DeviceModel {
  id           String        @id @default(cuid())
  name         String // e.g. "OptiPlex 7090", "ThinkPad T14", "LaserJet Pro M404dn"
  category     String // e.g. "Computer", "Monitor", "Printer"
  brandId      String
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  motherboards Motherboard[]
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, brandId])
}

model Motherboard {
  id        String      @id @default(cuid())
  brandId   String
  brand     Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  modelId   String
  model     DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  remarks   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([brandId, modelId])
}

model StorageSpec {
  id         String   @id @default(cuid())
  driveType  String // "SSD", "HDD", "NVMe SSD", "Hybrid (SSHD)"
  capacity   String // e.g. "256 GB", "512 GB", "1 TB", "2 TB"
  interface  String // e.g. "SATA III", "PCIe NVMe Gen 3", "PCIe NVMe Gen 4", "SAS"
  formFactor String   @default("2.5 Inch") // "2.5 Inch", "3.5 Inch", "M.2 2280", "M.2 2230"
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([driveType, capacity, interface, formFactor])
}

model GraphicsCard {
  id             String   @id @default(cuid())
  chipsetBrand   String // "NVIDIA", "AMD", "Intel", "Apple"
  series         String? // e.g., "GeForce RTX 40 Series", "Radeon RX 6000", "Intel Arc"
  modelName      String // e.g., "RTX 3060", "RTX 4070 Ti", "RX 6600 XT", "Iris Xe"
  memoryCapacity String // e.g., "8 GB", "12 GB", "16 GB", "Shared"
  memoryType     String   @default("GDDR6") // "GDDR6X", "GDDR6", "GDDR5", "Shared DDR4", "Shared DDR5"
  cardType       String   @default("Dedicated") // "Dedicated (Discrete)", "Integrated (iGPU)", "Low Profile"
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chipsetBrand, modelName, memoryCapacity])
}

model PsuSpec {
  id        String   @id @default(cuid())
  name      String   // e.g., "Corsair CV550", "Gigabyte P650B", "Dell Optiplex 260W OEM"
  wattage   String   // e.g., "550W", "650W", "260W"
  remarks   String?  // Optional notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, wattage])
}

model Ram {
  id         String   @id @default(cuid())
  capacity   String // e.g. "8 GB", "16 GB", "32 GB"
  ramType    String // e.g. "DDR3", "DDR4", "DDR5"
  busSpeed   String // e.g. "2666 MHz", "3200 MHz", "4800 MHz"
  formFactor String   @default("DIMM") // "DIMM (Desktop)", "SO-DIMM (Laptop)"
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([capacity, ramType, busSpeed, formFactor])
}

model Processor {
  id           String   @id @default(cuid())
  name         String // e.g. "Core i5-10400", "Ryzen 5 5600G"
  brand        String // "Intel", "AMD", "Apple", "Other"
  series       String? // e.g. "Core i5", "Ryzen 5", "Xeon"
  generation   String? // e.g. "10th Gen", "5000 Series"
  baseSpeed    String? // e.g. "2.90 GHz"
  coresThreads String? // e.g. "6 Cores / 12 Threads"
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, brand])
}

model Section {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  employees    Employee[]
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
// Audi log

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   // e.g. "PSU", "RAM", "Brand", "Model"
  entityId   String   // The ID of the modified record
  action     String   // "CREATE", "UPDATE", "DELETE"
  userName   String   // Name or email of the user who made the change
  details    String?  // Optional description or JSON string of changes
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
// System License
model SystemLicense {
  id                  String    @id @default("default-license")
  licenseName         String?   @default("Enterprise Workspace License")
  planType            String?   @default("MONTHLY CLOUD SUBSCRIPTION")
  noticeDate          DateTime?
  expirationDate      DateTime?
  enforceRestrictions Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_PRISMA_DATABASE_URL")
}
