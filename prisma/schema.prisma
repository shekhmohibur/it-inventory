generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINEE
  MANAGER
  ADMIN
}
model RolePermission {
  id          String   @id @default(cuid())
  roleName    String   @unique
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  permissions Json     @default("[]") // String array of granted keys, e.g. ["dashboard:view", "users:create"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  cardNumber   String?       @unique // Card / Employee Punch ID Number
  fullName     String
  email        String        @unique
  phone        String?
  department   String?
  designation  String?
  image        String?
  passwordHash String
  role         String   @default("TRAINEE")
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Organization {
  id                String   @id @default("default-org")
  // General Information
  businessName      String?
  shortName         String?
  emailAddress      String?
  phoneNumber       String?
  physicalAddress   String?
  workingHours      String?
  footerDescription String?
  systemTimezone    String?

  // SEO & Metadata
  globalMetaTitle   String?
  metaKeywords      String?
  metaDescription   String?
  robotsTxt         String?

  // Social Links
  facebookUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  youtubeUrl        String?

  // Branding & Media
  mainLogo          String?
  favicon           String?
  ogImage           String?
  officialSignature String?
  primaryColor      String?
  secondaryColor    String?
  accentColor       String?

  // Analytics
  ga4Id             String?
  fbPixelId         String?

  updatedAt         DateTime @updatedAt
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}