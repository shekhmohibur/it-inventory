generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINEE
  MANAGER
  ADMIN
}

model RolePermission {
  id          String   @id @default(cuid())
  roleName    String   @unique
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  permissions Json     @default("[]") // String array of granted keys, e.g. ["dashboard:view", "users:create"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  cardNumber   String?       @unique // Card / Employee Punch ID Number
  fullName     String
  email        String        @unique
  phone        String?
  department   String?
  designation  String?
  image        String?
  passwordHash String
  employees    Employee[]
  role         String        @default("TRAINEE")
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Employee {
  id            String   @id @default(cuid())
  employeeCode  String   @unique // e.g. EMP-1001, Punch ID
  name          String
  designation   String
  contactNumber String
  personalEmail String?
  officeEmail   String?
  joiningDate   DateTime
  status        String   @default("Active") // Active, Inactive

  // Hierarchy relations
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId    String?
  section      Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Optional link to system login account if they are also an app user
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// Devices status

model DeviceStatus {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#0010F5")
  visibility  String   @default("Active") // Active, Inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id                String  @id @default("default-org")
  // General Information
  businessName      String?
  shortName         String?
  emailAddress      String?
  phoneNumber       String?
  physicalAddress   String?
  workingHours      String?
  footerDescription String?
  systemTimezone    String?

  // SEO & Metadata
  globalMetaTitle String?
  metaKeywords    String?
  metaDescription String?
  robotsTxt       String?

  // Social Links
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?

  // Branding & Media
  mainLogo          String?
  favicon           String?
  ogImage           String?
  officialSignature String?
  primaryColor      String?
  secondaryColor    String?
  accentColor       String?

  // Analytics
  ga4Id     String?
  fbPixelId String?

  updatedAt DateTime @updatedAt
}

// Master Data model
model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  shortName   String?
  address     String?
  logo        String?
  departments Department[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String     @id @default(cuid())
  name        String
  description String?
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections    Section[]
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, companyId])
}


// hardware specs

model Brand {
  id        String   @id @default(cuid())
  name      String
  category  String
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
}

model Ram {
  id         String   @id @default(cuid())
  capacity   String   // e.g. "8 GB", "16 GB", "32 GB"
  ramType    String   // e.g. "DDR3", "DDR4", "DDR5"
  busSpeed   String   // e.g. "2666 MHz", "3200 MHz", "4800 MHz"
  formFactor String   @default("DIMM") // "DIMM (Desktop)", "SO-DIMM (Laptop)"
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([capacity, ramType, busSpeed, formFactor])
}

model Section {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  employees    Employee[]
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// System License
model SystemLicense {
  id                  String    @id @default("default-license")
  licenseName         String?   @default("Enterprise Workspace License")
  planType            String?   @default("MONTHLY CLOUD SUBSCRIPTION")
  noticeDate          DateTime?
  expirationDate      DateTime?
  enforceRestrictions Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
